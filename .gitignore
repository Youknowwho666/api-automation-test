# ---------- 虚拟环境 ----------
venv/
.venv/
env/

# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# ---------- 测试产物 ----------
reports/*
!reports/.gitkeep
logs/*
!logs/.gitkeep
.pytest_cache/
allure-results/
allure-report/
auth_state.json
# conftest.py 清理 Allure 结果时的暂存目录
.allure-results.stale*/

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp
.DS_Store

# ---------- 环境变量（含密钥，绝不入库）----------
.env
.env.local
